{
  "name": "nutricommunity_backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "compile": "docker compose up --build --force-recreate --remove-orphans -d",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage --ci",
    "test:schemas": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/unit/schemas",
    "test:tokens": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/unit/tokens",
    "test:middlewares": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/unit/middlewares",
    "test:services": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/unit/services",
    "test:http": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/http",
    "test:auth": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPatterns='(auth|token|authenticate|csrf)'",
    "test:posts": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPatterns='post'",
    "test:comments": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPatterns='comment'",
    "test:reactions": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPatterns='reaction'",
    "test:admin": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPatterns='admin'",
    "test:coverage:auth": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage --testPathPatterns='(auth|token|authenticate|csrf|controllers)' --collectCoverageFrom='src/schemas/auth.schema.ts' --collectCoverageFrom='src/services/auth.service.ts' --collectCoverageFrom='src/services/token.service.ts' --collectCoverageFrom='src/middlewares/authenticate.ts' --collectCoverageFrom='src/middlewares/csrf.ts' --collectCoverageFrom='src/controllers/auth.controller.ts'",
    "test:coverage:controllers": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage tests/http --collectCoverageFrom='src/controllers/**/*.ts'",
    "test:coverage:services": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage tests/unit/services tests/unit/tokens --collectCoverageFrom='src/services/**/*.ts'",
    "test:coverage:schemas": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage tests/unit/schemas --collectCoverageFrom='src/schemas/**/*.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [],
  "author": "Eduardo Camberos",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.2"
  }
}
